{
  "name": "bismillah-spray-center-backend",
  "version": "1.0.0",
  "description": "Backend API for Bismillah Spray Center",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon",
    "test": "node --test",
    "seed:admin": "node src/utils/seedAdmin.js",
    "clean": "node src/utils/cleanDatabase.js",
    "migrate:images": "node src/utils/migrateImagesToCloudinary.js",
    "migrate:media": "node src/utils/migrateMediaToCloudinary.js",
    "backup": "node src/utils/backup.js",
    "migrate:reviews": "node src/utils/linkLegacyReviews.js",
    "backup:verify": "node src/utils/verifyBackup.js",
    "backup:restore-check": "node src/utils/restoreCheck.js",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\""
  },
  "keywords": [
    "agriculture",
    "pesticides",
    "pakistan",
    "express",
    "mongodb"
  ],
  "author": "Bismillah Spray Center",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.2.0",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "prettier": "3.9.10"
  }
}
